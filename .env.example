# Optional Supabase configuration.
# Leave these blank to run in fully local mode (Rooms/Agents/Skills/Providers use browser storage).
# Set both values to enable cloud-powered features.

# Local Supabase example:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# Remote Supabase example:
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=

# Local anon key from `supabase start` output or dashboard publishable/anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
